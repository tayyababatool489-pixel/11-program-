// 11. Online Exam Time Alert
// Write a C++ program that takes the remaining exam time in minutes as input.
// If 5 minutes or less remain, display "Warning: Exam Is About to End".
#include <iostream>
using namespace std;

int main() {
    int remainingTime;
    cout << "Enter remaining exam time in minutes: ";
    cin >> remainingTime;

    if (remainingTime <= 5) {
        cout << "Warning: Exam Is About to End";
    }
    return 0;
}