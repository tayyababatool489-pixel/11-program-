// 7. Office Attendance Warning
// Write a C++ program that takes an employee's attendance percentage as input.
// If the attendance percentage is below 75%, display "Attendance Warning".
#include <iostream>
using namespace std;

int main() {
    float attendance;
    cout << "Enter attendance percentage: ";
    cin >> attendance;

    if (attendance < 75) {
        cout << "Attendance Warning";
    }
    return 0;
}